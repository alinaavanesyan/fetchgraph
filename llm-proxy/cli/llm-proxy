#!/usr/bin/env bash
set -euo pipefail

# llm-proxy — manage LLM Proxy profiles + docker compose runtime.
# Profiles live under $HOME (XDG dirs by default). Repo stays clean.

PROG="llm-proxy"

die() {   
  printf '%s: %b\n' "${PROG:-llm-proxy}" "$*" >&2
  exit 1
  }

warn() { echo "$PROG: $*" >&2; }
is_macos() { [[ "${OSTYPE:-}" == "darwin"* ]]; }

# ---------------------------
# Paths (XDG + legacy support)
# ---------------------------
resolve_home() {
  if [[ -n "${LLM_PROXY_HOME:-}" ]]; then
    echo "${LLM_PROXY_HOME}"
    return
  fi
  # Legacy: if ~/.llm-proxy exists, keep using it to avoid breaking existing installs.
  if [[ -d "${HOME}/.llm-proxy" ]]; then
    echo "${HOME}/.llm-proxy"
    return
  fi
  echo ""
}

resolve_dirs() {
  local legacy_home
  legacy_home="$(resolve_home)"

  if [[ -n "$legacy_home" ]]; then
    CONFIG_DIR="${legacy_home}/config"
    DATA_DIR="${legacy_home}/data"
    CACHE_DIR="${legacy_home}/cache"
  else
    CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/${PROG}"
    DATA_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/${PROG}"
    CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/${PROG}"
  fi

  PROFILES_DIR="${CONFIG_DIR}/profiles"
  ACTIVE_FILE="${CONFIG_DIR}/active_profile"

  # Per-profile "owned" dirs we can safely delete on profile delete:
  PROFILE_DATA_ROOT="${DATA_DIR}/profiles"
  PROFILE_LOG_ROOT="${DATA_DIR}/logs"
  PROFILE_CACHE_ROOT="${CACHE_DIR}/profiles"

  PROJECT_DIR_FILE="${CONFIG_DIR}/project_dir"
}

detect_compose_service_name() {
  local compose_file="$1"

  if [[ -n "${LLM_PROXY_SERVICE:-}" ]]; then
    echo "${LLM_PROXY_SERVICE}"
    return 0
  fi

  # Portable awk (macOS awk compatible). Picks first service under services:.
  awk '
    $1=="services:" {in_services=1; next}
    in_services && $0 ~ /^[[:space:]][[:space:]][A-Za-z0-9_.-]+:[[:space:]]*$/ {
      line=$0
      sub(/^[[:space:]]+/, "", line)
      sub(/:[[:space:]]*$/, "", line)
      print line
      exit
    }
  ' "$compose_file"
}

ensure_dirs() {
  mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$CACHE_DIR" "$PROFILES_DIR" \
           "$PROFILE_DATA_ROOT" "$PROFILE_LOG_ROOT" "$PROFILE_CACHE_ROOT"
}

# Reads a KEY from env-file (KEY=VALUE), strips quotes if any.
envfile_get() {
  local file="$1" key="$2"
  local line
  line="$(grep -E "^[[:space:]]*${key}=" "$file" | tail -n1 || true)"
  [[ -n "$line" ]] || return 1
  line="${line#*=}"
  line="${line%$'\r'}"
  # strip optional quotes
  line="${line%\"}"; line="${line#\"}"
  line="${line%\'}"; line="${line#\'}"
  printf '%s' "$line"
}

derive_debug_image() {
  local base="$1"
  local repo tag
  if [[ "$base" == *:* ]]; then
    repo="${base%:*}"
    tag="${base##*:}"
  else
    repo="$base"
    tag="latest"
  fi
  echo "${repo}:${tag}-debug"
}

# Resolve the effective image name as docker compose sees it (including ${VAR:-default} fallbacks).
# This avoids requiring LLM_IMAGE to be present in the profile env file.
resolve_compose_image() {
  local project_dir="$1" compose_env="$2" service="$3" override="$4"

  local args=()
  args+=(-f "${project_dir}/compose.yaml")
  [[ -n "$override" ]] && args+=(-f "$override")

  docker compose \
    --project-directory "$project_dir" \
    "${args[@]}" \
    --env-file "$compose_env" \
    config \
  | awk -v svc="$service" '
      $1=="services:" {in_services=1; next}
      in_services && $0 ~ /^[[:space:]]{2}[A-Za-z0-9_.-]+:[[:space:]]*$/ {
        line=$0
        sub(/^[[:space:]]+/, "", line)
        sub(/:[[:space:]]*$/, "", line)
        in_target = (line == svc)
        next
      }
      in_target && $1=="image:" {print $2; exit}
    '
}

# Source-of-truth for base image:
# 1) if profile env explicitly defines LLM_IMAGE, use it
# 2) otherwise ask docker compose to resolve defaults and return the final image value
resolve_base_image() {
  local project_dir="$1" compose_env="$2" service="$3" override="$4"
  local base=""
  base="$(envfile_get "$compose_env" "LLM_IMAGE" 2>/dev/null || true)"
  if [[ -n "$base" ]]; then
    echo "$base"
    return 0
  fi
  base="$(resolve_compose_image "$project_dir" "$compose_env" "$service" "$override" || true)"
  [[ -n "$base" ]] || return 1
  echo "$base"
}

sanitize_profile_name() {
  local name="${1:-}"
  [[ -n "$name" ]] || return 1
  if [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    # Guardrail: runtime env files use "<name>.llm.env".
    # If user can create profile "<name>.llm", it leads to cascading "<name>.llm.llm" etc.
    if [[ "$name" == *.llm ]]; then
      return 1
    fi
    echo "$name"
    return 0
  fi
  return 1
}

profile_compose_env_path() {
  local name="$1"
  echo "${PROFILES_DIR}/${name}.env"
}

profile_runtime_env_path() {
  local name="$1"
  echo "${PROFILES_DIR}/${name}.llm.env"
}

get_active_profile() {
  if [[ -f "$ACTIVE_FILE" ]]; then
    sed -n '1p' "$ACTIVE_FILE" | tr -d '[:space:]'
  else
    echo ""
  fi
}

set_active_profile() {
  local name="$1"
  printf '%s\n' "$name" > "$ACTIVE_FILE"
}

clear_active_profile() {
  rm -f "$ACTIVE_FILE"
}

pick_fallback_profile() {
  local exclude="${1:-}"

  if [[ "$exclude" != "default" ]]; then
    if [[ -f "$(profile_compose_env_path default)" || -f "$(profile_runtime_env_path default)" ]]; then
      echo "default"
      return 0
    fi
  fi

  local names=()
  local -A seen=()
  local f name base
  shopt -s nullglob
  for f in "${PROFILES_DIR}/"*.env "${PROFILES_DIR}/"*.llm.env; do
    base="${f##*/}"
    if [[ "$base" == *.llm.env ]]; then
      name="${base%.llm.env}"
    else
      name="${base%.env}"
    fi

    if [[ "$name" == "$exclude" ]]; then
      continue
    fi

    if [[ -n "${seen[$name]:-}" ]]; then
      continue
    fi
    seen[$name]=1
    names+=("$name")
  done
  shopt -u nullglob

  if [[ "${#names[@]}" -gt 0 ]]; then
    mapfile -d '' -t names < <(printf '%s\0' "${names[@]}" | sort -z)
    for name in "${names[@]}"; do
      echo "$name"
      return 0
    done
  fi

  return 1
}

list_profiles() {
  local active bold reset green blue color_ok
  active="$(get_active_profile)"

  bold=""
  reset=""
  green=""
  blue=""
  color_ok=0

  if [[ -t 1 ]]; then
    if command -v tput >/dev/null 2>&1; then
      local colors
      colors="$(tput colors 2>/dev/null || echo 0)"
      if [[ "$colors" -ge 8 ]]; then
        color_ok=1
        green="$(tput setaf 2 2>/dev/null || echo '')"
        blue="$(tput setaf 4 2>/dev/null || echo '')"
      fi
      bold="$(tput bold 2>/dev/null || echo '')"
      reset="$(tput sgr0 2>/dev/null || echo '')"
    fi

    [[ -z "$bold" ]] && bold=$'\033[1m'
    [[ -z "$reset" ]] && reset=$'\033[0m'
    if [[ "$color_ok" -eq 1 ]]; then
      [[ -z "$green" ]] && green=$'\033[32m'
      [[ -z "$blue" ]] && blue=$'\033[34m'
    fi
  fi

  local name
  while IFS= read -r name; do
    if [[ "$name" == "$active" ]]; then
      local color
      color=""
      if [[ "$color_ok" -eq 1 ]]; then
        color="${green:-${blue:-}}"
        if [[ -z "$color" ]]; then
          color="$blue"
        fi
      fi

      if [[ -t 1 ]]; then
        printf "* %s%s%s\n" "${color}${bold}" "$name" "$reset"
      else
        echo "* $name"
      fi
    else
      echo "  $name"
    fi
  done < <(list_profile_names)
}

list_profile_names() {
  shopt -s nullglob
  local f
  for f in "${PROFILES_DIR}/"*.env; do
    if [[ "$f" == *.llm.env ]]; then
      continue
    fi
    basename "$f" .env
  done
  shopt -u nullglob
}

# ---------------------------
# Project dir (where compose.yaml lives)
# ---------------------------
resolve_project_dir_soft() {
  if [[ -n "${LLM_PROXY_PROJECT_DIR:-}" ]]; then
    [[ -f "${LLM_PROXY_PROJECT_DIR}/compose.yaml" ]] || return 1
    echo "${LLM_PROXY_PROJECT_DIR}"
    return 0
  fi

  if [[ -f "${PROJECT_DIR_FILE:-}" ]]; then
    local saved
    saved="$(sed -n '1p' "$PROJECT_DIR_FILE" | tr -d '\r\n')"
    if [[ -n "$saved" && -f "${saved}/compose.yaml" ]]; then
      echo "$saved"
      return 0
    fi
  fi

  local here
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || return 1
  if [[ -f "${here}/compose.yaml" ]]; then
    echo "${here}"
    return 0
  fi

  return 1
}

resolve_project_dir() {
  # 1) explicit override
  if [[ -n "${LLM_PROXY_PROJECT_DIR:-}" ]]; then
    [[ -f "${LLM_PROXY_PROJECT_DIR}/compose.yaml" ]] || die "compose.yaml not found in LLM_PROXY_PROJECT_DIR=${LLM_PROXY_PROJECT_DIR}"
    echo "${LLM_PROXY_PROJECT_DIR}"
    return
  fi

  # 2) config fallback (set during install)
  if [[ -f "${PROJECT_DIR_FILE:-}" ]]; then
    local saved
    saved="$(sed -n '1p' "$PROJECT_DIR_FILE" | tr -d '\r\n')"
    if [[ -n "$saved" && -f "${saved}/compose.yaml" ]]; then
      echo "$saved"
      return
    fi
  fi

  # 3) config fallback (set during install)
  if [[ -f "${PROJECT_DIR_FILE:-}" ]]; then
    local saved
    saved="$(sed -n '1p' "$PROJECT_DIR_FILE" | tr -d '\r\n')"
    if [[ -n "$saved" && -f "${saved}/compose.yaml" ]]; then
      echo "$saved"
      return
    fi
  fi

  # 4) relative to script location (works when running from repo checkout)
  local here
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  if [[ -f "${here}/compose.yaml" ]]; then
    echo "${here}"
    return
  fi

  die "cannot locate compose.yaml. Run from repo root, or set LLM_PROXY_PROJECT_DIR=/path/to/repo"
}

compose_services_from_file() {
  local compose_file="$1"
  awk '
    $1=="services:" {in_services=1; next}
    in_services && $0 ~ /^[[:space:]][[:space:]][A-Za-z0-9_.-]+:[[:space:]]*$/ {
      line=$0
      sub(/^[[:space:]]+/, "", line)
      sub(/:[[:space:]]*$/, "", line)
      print line
      next
    }
    in_services && $0 !~ /^[[:space:]]/ {exit}
  ' "$compose_file"
}

completion_service_names() {
  local project_dir compose_file
  project_dir="$(resolve_project_dir_soft)" || return 0
  compose_file="${project_dir}/compose.yaml"
  [[ -f "$compose_file" ]] || return 0

  compose_services_from_file "$compose_file"
}

completion_profiles() {
  # Prints one profile per line for completion consumers.
  list_profile_names
}

commands_list() {
  cat <<'EOF'
help
list
ls
active
init
create
