# -----------------------
# Service
# -----------------------
LOG_LEVEL=INFO
ENV=development
TESTING=false

# -----------------------
# Upstream LLM
# -----------------------
LLM_API_BASE=https://api.llm7.io/v1
LLM_API_KEY=unused
LLM_DEFAULT_MODEL_NAME=deepseek-v3-0324
# Optional hard override (forces this model for all requests)
# LLM_MODEL_NAME=deepseek-v3-0324

LLM_TEMPERATURE=0.0
LLM_TOP_P=1.0
LLM_MAX_TOKENS=50000
LLM_VERBOSE=true
LLM_TIMEOUT=300.0

# -----------------------
# Concurrency / queue
# -----------------------
LLM_MAX_CONCURRENT=1
LLM_QUEUE_MAX_LEN=100
LLM_PRIORITY_DEFAULT=p2

# Важно: это должен быть JSON (строка)
LLM_PRIORITY_SLOTS={"p1":2,"p2":1,"p3":1}

# -----------------------
# Cache
# -----------------------
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL=600000

# Вариант A: задаёшь полный путь напрямую (имеет приоритет)
# LLM_CACHE_PATH=/cache/llm_cache.sqlite

# Вариант B: путь собирается из CACHE_CONTAINER_DIR + LLM_CACHE_FILE
CACHE_CONTAINER_DIR=/cache
LLM_CACHE_FILE=llm_cache.sqlite
