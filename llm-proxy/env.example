# Compose substitution variables (optional quickstart without CLI profiles)

# Image/build
LLM_IMAGE=llm-proxy:latest
LLM_BUILD_CONTEXT=.
LLM_DOCKERFILE=Dockerfile

# Ports
LLM_PORT=8002

# Host mount dirs (relative to repo root is OK)
CACHE_HOST_DIR=./cache
LOGS_HOST_DIR=./logs
DUMP_HOST_DIR=./crash_dumps

# Container mount dirs
CACHE_CONTAINER_DIR=/cache
LOGS_CONTAINER_DIR=/logs
DUMP_CONTAINER_DIR=/crash_dumps

# Runtime env file used by the service
LLM_ENV_FILE=./llm.env
